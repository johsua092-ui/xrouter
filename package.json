{
  "name": "xrouter-app",
  "version": "0.1.0",
  "description": "X Router web dashboard",
  "private": true,
  "contributors": [
    {
      "name": "Bayu (BvsshXyz)",
      "url": "https://github.com/BvsshXyz"
    },
    {
      "name": "Naub (naummi)",
      "url": "https://github.com/naummi"
    }
  ],
  "scripts": {
    "dev": "cross-env NEXT_DIST_DIR=.next-dev next dev --port 20128 --hostname 127.0.0.1",
    "dev:webpack": "cross-env NEXT_DIST_DIR=.next-dev next dev --port 20128 --hostname 127.0.0.1",
    "build": "next build --webpack",
    "build:go": "go build -trimpath -ldflags=\"-s -w\" -o bin/xrouter ./cmd/xrouter && (which upx >/dev/null 2>&1 && upx --best --lzma bin/xrouter || true)",
    "start:go": "./bin/xrouter",
    "postbuild": "node scripts/copy-standalone-assets.mjs",
    "postbuild:bun": "node scripts/copy-standalone-assets.mjs",
    "start": "node --expose-gc --max-old-space-size=512 custom-server.js",
    "dev:bun": "bun --bun next dev --port 20127",
    "build:bun": "bun --bun next build",
    "start:bun": "bun ./.next/standalone/custom-server.js",
    "cli:pack": "npm --prefix cli run pack:cli",
    "cli:publish": "npm --prefix cli run publish:cli",
    "lint": "eslint src open-sse scripts",
    "test": "npm --prefix tests test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@grammyjs/runner": "^2.0.3",
    "@monaco-editor/react": "^4.7.0",
    "@next/third-parties": "^16.2.9",
    "@node-saml/node-saml": "^5.1.0",
    "@prisma/client": "^5.22.0",
    "@xyflow/react": "^12.10.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "chalk": "^5.6.2",
    "cheerio": "^1.0.0",
    "confbox": "^0.2.4",
    "diff": "9.0.0",
    "geist": "^1.9.2",
    "grammy": "^1.46.0",
    "ioredis": "^5.4.1",
    "jose": "^5.9.6",
    "js-yaml": "^4.1.0",
    "marked": "^15.0.7",
    "material-symbols": "^0.44.6",
    "next": "16.4.5",
    "next-themes": "^0.4.4",
    "node-forge": "^1.3.3",
    "node-machine-id": "^1.1.12",
    "open": "^11.0.0",
    "ora": "^9.1.0",
    "prop-types": "^15.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.53.1",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^5.3.0",
    "react-markdown": "^9.0.1",
    "react-syntax-highlighter": "16.1.2",
    "recharts": "^3.7.0",
    "sharp": "0.35.5",
    "socks-proxy-agent": "^8.0.5",
    "sql.js": "^1.14.1",
    "undici": "^7.30.1",
    "uuid": "^13.0.0",
    "wreq-js": "^3.2.0",
    "ws": "^8.22.1",
    "zod": "4.6.7",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/better-sqlite3": "^7.6.11",
    "@types/diff": "^7.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.9.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-syntax-highlighter": "^15.2.3",
    "cross-env": "^10.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "postcss": "^8.5.6",
    "tailwindcss": "^4",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "3.4.17"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.5"
    }
  }
}
