package main

import (
	"crypto/sha3"
	"encoding/hex"
	"fmt"
	"os"

	"github.com/johsua092-ui/xrouter/internal/providers"
)

func main() {
	// 1. Control: does the 24-round path match stdlib SHA3-256?
	inputs := []string{"", "abc", "hello world", "a", "The quick brown fox jumps over the lazy dog",
		"01234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789"}
	for _, in := range inputs {
		ours := providers.FIPS202Control(in)
		h := sha3.New256()
		h.Write([]byte(in))
		theirs := hex.EncodeToString(h.Sum(nil))
		status := "OK "
		if ours != theirs {
			status = "DIFF"
		}
		fmt.Printf("  %s control %-12q %s\n", status, truncate(in, 12), ours)
	}

	// 2. Print DeepSeekHashV1 for Node to compare.
	fmt.Println("DSV1")
	for _, in := range []string{"", "abc", "abc_123_", "salt_1700000000_0", "salt_1700000000_1"} {
		fmt.Printf("%s|%s\n", in, providers.DeepSeekHashV1(in))
	}
	fmt.Println("END")
}

func truncate(s string, n int) string {
	if len(s) <= n {
		return s
	}
	return s[:n]
}
